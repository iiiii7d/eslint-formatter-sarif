{
  "name": "eslint-formatter-sarif",
  "version": "1.0.0",
  "main": "main.js",
  "private": "true",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "eslint ${@:-.}",
    "lint:fix": "eslint --fix ${@:-.}",
    "lint:sarif": "eslint -f ./main.ts --fix ${@:-.} || true",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@total-typescript/tsconfig": "1.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.1.1",
    "@types/sarif": "2.1.7",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0"
  }
}
